!openclaw/config/workspace/IDENTITY.md
!openclaw/config/workspace/SOUL.md
!openclaw/config/workspace/TOOLS.md
!openclaw/config/workspace/USER.md

bitwarden/data/
**/data/*
**/logs/*
**/metadata/*

# Service-specific directories
nginx-proxy-manager/letsencrypt/*
palworld/win/*
pi-hole/etc-*/*
pi/pi-hole/etc-*/*
