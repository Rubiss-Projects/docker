# Environment files containing secrets
**/.env
**/db.env

# Exclude example files from being ignored
!**/.env.example

# Data and config directories
**/config/*
**/data/*
**/logs/*
**/metadata/*

# Service-specific directories
nginx-proxy-manager/letsencrypt/*
palworld/win/*
pi-hole/etc-*/*
pi/pi-hole/etc-*/*
plex/library/*
vrising/Backups/*
vrising/persistentdata/*
vrising/server/*
channels-dvr/recordings/*

# Backup files
*.backup
*.bak

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
