plex/library/*
vrising/Backups/*
vrising/persistentdata/*
vrising/server/*
channels-dvr/recordings/*

# Operator-managed configuration that is safe to review/change in GitHub.
!prometheus/config/prometheus.yml
!recyclarr/config/recyclarr.yml
!recyclarr/config/settings.yml
!valheim/config/adminlist.txt
!valheim/config/bannedlist.txt
!valheim/config/permittedlist.txt
!vrising/persistentdata/Settings/
