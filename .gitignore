# Environment files containing secrets
# (Managed by git-crypt, so we do NOT ignore them)

# Data and config directories
**/config/*
!homepage/config/
!homepage/config/*
!swag/config/**
!openclaw/config/workspace/
!openclaw/config/workspace/**
!openclaw/config/openclaw.json
!openclaw/config/auth-profiles.json
!openclaw/config/agents/
!openclaw/config/agents/**
openclaw/config/agents/*/sessions/
**/data/*
**/logs/*
**/metadata/*

# Service-specific directories
nginx-proxy-manager/letsencrypt/*
palworld/win/*
pi-hole/etc-*/*
pi/pi-hole/etc-*/*
!pi/pi-hole/etc-dnsmasq.d/99-blitz-ads.conf
plex/library/*
vrising/Backups/*
vrising/persistentdata/*
vrising/server/*
channels-dvr/recordings/*

# Backup files
*.backup
*.bak
backups/

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
