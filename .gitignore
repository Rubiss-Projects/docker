# Environment files containing secrets
# (Managed by git-crypt, so we do NOT ignore them)

# Data and config directories
**/config/*
!homepage/config/
!homepage/config/*
!swag/config/**

# OpenClaw - only track openclaw.json and specific workspace markdown files
!openclaw/config/openclaw.json
!openclaw/config/workspace/
openclaw/config/workspace/*
!openclaw/config/workspace/AGENTS.md
!openclaw/config/workspace/BOOTSTRAP.md
!openclaw/config/workspace/HEARTBEAT.md
!openclaw/config/workspace/IDENTITY.md
!openclaw/config/workspace/SOUL.md
!openclaw/config/workspace/TOOLS.md
!openclaw/config/workspace/USER.md

**/data/*
**/logs/*
**/metadata/*

# Service-specific directories
nginx-proxy-manager/letsencrypt/*
palworld/win/*
pi-hole/etc-*/*
pi/pi-hole/etc-*/*
!pi/pi-hole/etc-dnsmasq.d/99-blitz-ads.conf
plex/library/*
vrising/Backups/*
vrising/persistentdata/*
vrising/server/*
channels-dvr/recordings/*

# Backup files
*.backup
*.bak
backups/

# OS generated files
.DS_Store
Thumbs.db

# Editor files
.idea/
*.swp
*.swo
*~
