[Unit]
Description=Consistent Bitwarden recovery set and encrypted NAS restore verification
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
RequiresMountsFor=/srv/RecoveryReturn

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/lib/native-backup/repository.py /etc/native-backup/vault.json
TimeoutStartSec=7200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/native-backup /srv/RecoveryReturn
