# Actual Server Configuration
ACTUAL_SERVER_URL=http://actual:5006
ACTUAL_PASSWORD=your_actual_password
ACTUAL_BUDGET_ID=your_actual_budget_id
ACTUAL_E2E_PASSWORD=

# Classification Schedule (cron format)
CLASSIFICATION_SCHEDULE_CRON=0 */4 * * *

# LLM Provider Configuration
# Can be "openai", "anthropic", "google-generative-ai", "ollama" or "groq"
LLM_PROVIDER=openai

# Features
# Available features: "classifyOnStartup", "syncAccountsBeforeClassify", "freeWebSearch", "suggestNewCategories"
FEATURES=["classifyOnStartup", "syncAccountsBeforeClassify", "freeWebSearch", "suggestNewCategories"]

# Web Search API
VALUESERP_API_KEY=

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Generative AI Configuration
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-1.5-flash
GOOGLE_GENERATIVE_AI_BASE_URL=https://generativelanguage.googleapis.com

# Ollama Configuration
OLLAMA_MODEL=phi3.5
OLLAMA_BASE_URL=http://localhost:11434/api

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Advanced Settings
NODE_TLS_REJECT_UNAUTHORIZED=0
NOT_GUESSED_TAG=#actual-ai-miss
GUESSED_TAG=#actual-ai