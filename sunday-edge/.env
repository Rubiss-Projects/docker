# Public defaults. Compose restores two replicas; the controller selects 2–6
# active logical slots without changing the six-slot allocation capacity.
TZ=America/New_York
SUNDAY_EDGE_URL=https://fantasy.benlawson.dev
DFS_REPLICAS=2
DFS_MAX_WORKER_SLOTS=6
DFS_WORKER_POOL_ID=ben-server
DFS_CPUS=1.0
DFS_MEMORY=512m
ANALYTICS_CPUS=2.0
ANALYTICS_MEMORY=2g
MAINTENANCE_CPUS=1.0
MAINTENANCE_MEMORY=2g
RESEARCH_CPUS=0.5
RESEARCH_MEMORY=512m
SCHEDULER_CPUS=0.1
SCHEDULER_MEMORY=128m
# Use the same model and reasoning effort for extraction and mandatory review.
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=max
CODEX_ESCALATION_MODEL=gpt-6.1-sol
CODEX_ESCALATION_REASONING_EFFORT=max
# Milliseconds per model phase; worker supports 30000-600000 and reserves both phases.
CODEX_BATCH_TIMEOUT_MS=480000
# Informational article verification only; total allowance does not refill.
JEV_MODE=observe
JEV_MODEL=jev-1.13.0
JEV_DAILY_BUDGET_USD=0.15
JEV_MONTHLY_BUDGET_USD=2
JEV_TOTAL_BUDGET_USD=3

MONITOR_CPUS=1.0
MONITOR_MEMORY=1g
