# Public, non-secret settings. Changing DFS_REPLICAS recreates and rescales the
# compute pool. Keep between 1 and 32; each replica has its own resource limit.
TZ=America/New_York
SUNDAY_EDGE_URL=https://fantasy.benlawson.dev
DFS_REPLICAS=6
DFS_WORKER_POOL_ID=ben-server
DFS_CPUS=1.0
DFS_MEMORY=512m
ANALYTICS_CPUS=2.0
ANALYTICS_MEMORY=2g
MAINTENANCE_CPUS=1.0
MAINTENANCE_MEMORY=2g
RESEARCH_CPUS=0.5
RESEARCH_MEMORY=512m
SCHEDULER_CPUS=0.1
SCHEDULER_MEMORY=128m
# Informational article verification only; total allowance does not refill.
JEV_MODE=observe
JEV_MODEL=jev-1.13.0
JEV_DAILY_BUDGET_USD=0.15
JEV_MONTHLY_BUDGET_USD=2
JEV_TOTAL_BUDGET_USD=3

MONITOR_CPUS=1.0
MONITOR_MEMORY=1g
