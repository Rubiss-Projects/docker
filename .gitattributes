# Encrypt per-service secret env overlays
*.env.secret filter=git-crypt diff=git-crypt

# Encrypt openclaw config JSON files (contain API tokens)
openclaw/config/*.json filter=git-crypt diff=git-crypt
openclaw/config/agents/**/auth-profiles.json filter=git-crypt diff=git-crypt
openclaw/config/agents/**/models.json filter=git-crypt diff=git-crypt

# Encrypt Recyclarr secrets (API keys)
**/secrets.yml filter=git-crypt diff=git-crypt

# Encrypt SWAG DNS provider credentials
swag/config/dns-conf/*.ini filter=git-crypt diff=git-crypt
