PROVIDER=codex
AI_ASSISTANT_SYSTEM_PROMPT_FILE=/data/system-prompt.txt
CODEX_MODEL=gpt-6-astra
CODEX_REASONING_EFFORT=medium
AI_ASSISTANT_SECURITY_MODE=shared
AI_ASSISTANT_ENABLE_SITES=true
AI_ASSISTANT_ENABLE_GITHUB_CONTRIBUTIONS=true
GITHUB_CONTRIBUTIONS_ACCESS=chat
GITHUB_CONTRIBUTIONS_CONFIG_FILE=/data/.config/ai-assistant/github-apps/config.json
# The deployment's Level 3 boosted server supports 100 MiB uploads (server only).
AI_OUTPUT_ATTACHMENT_MAX_BYTES=104857600
AI_OUTPUT_ATTACHMENT_MAX_TOTAL_BYTES=104857600
DISCORD_MEMORY_RECALL_LIMIT=5
DISCORD_SUPPRESS_EMBEDS=true
REGISTER_COMMANDS_ON_START=true
SCHEDULES_ENABLED=true
DISCORD_RIGHTS_FILE=/etc/ai-assistant/rights.json
CHAT_PARTICIPATION_MODE=smart
CHAT_PARTICIPATION_EVALUATOR=jev
