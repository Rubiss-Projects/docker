# Runtime auth template, not loaded by any deployed service.
# Enable --config.expand-environment-variables in the future exporter.
# Store these three environment variables in snmp-exporter/.env.secret.
auths:
  qnap_v3:
    version: 3
    security_level: authPriv
    username: ${QNAP_SNMP_USERNAME}
    password: ${QNAP_SNMP_AUTH_PASSWORD}
    auth_protocol: SHA
    priv_password: ${QNAP_SNMP_PRIV_PASSWORD}
    # Verify the NAS's actual privacy protocol before copying this template.
    # Prefer AES if supported; do not silently fall back to another protocol.
    priv_protocol: AES
