    {
      "id": 11,
      "title": "NAS pool state",
      "type": "stat",
      "description": "Raw NAS pool state. Only 0 is verified as Ready. Other values remain numeric because the vendor MIB describes conflicting QTS and QuTS hero enumerations; reconcile them with the native API. Missing collection remains unavailable.",
      "datasource": {
        "type": "prometheus",
        "uid": "adw07verg2qrkd"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Ready",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          },
          "editorMode": "code",
          "expr": "storagepoolStatus{job=\"qnap-snmp\",instance=\"qnap-nas\"} and on(job, instance) (up{job=\"qnap-snmp\",instance=\"qnap-nas\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
