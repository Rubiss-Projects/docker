    {
      "id": 7,
      "type": "table",
      "title": "NAS-reported drive status",
      "description": "Raw NAS status, not a completed test. A new or moved drive is shown as unmapped until its native disk ID and serial are reconciled with the physical bay. No result is synthesized for missing drives.",
      "datasource": {
        "type": "prometheus",
        "uid": "adw07verg2qrkd"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          },
          "editorMode": "code",
          "expr": "diskStatus{job=\"qnap-snmp\",instance=\"qnap-nas\"} and on(job, instance) (up{job=\"qnap-snmp\",instance=\"qnap-nas\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "interval": "1m",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "diskIndex": true,
              "diskID": true
            },
            "indexByName": {
              "bay": 0,
              "diskSerialNumber": 1,
              "diskStatus": 2
            },
            "renameByName": {
              "bay": "Bay",
              "diskSerialNumber": "Drive serial",
              "diskStatus": "NAS status"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "NAS status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Good": {
                        "text": "Good (NAS report)",
                        "color": "green"
                      },
                      "Abnormal": {
                        "text": "Abnormal",
                        "color": "red"
                      },
                      "Warning": {
                        "text": "Warning",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Bay",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 9,
      "title": "Pool allocated",
      "type": "stat",
      "description": "NAS pool allocation includes thick allocations, reservations and metadata; it is not file payload usage.",
      "datasource": {
        "type": "prometheus",
        "uid": "adw07verg2qrkd"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          },
          "editorMode": "code",
          "expr": "100 * (1 - storagepoolFreeSize{job=\"qnap-snmp\",instance=\"qnap-nas\"} / storagepoolCapacity{job=\"qnap-snmp\",instance=\"qnap-nas\"}) and on(job, instance) (up{job=\"qnap-snmp\",instance=\"qnap-nas\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
