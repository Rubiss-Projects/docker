      "targets": [
        {
          "refId": "A",
          "expr": "nut:ups_status{flag=\"OL\"} and on() (nut:telemetry_available == 1)",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          }
        }
      ]
    },
