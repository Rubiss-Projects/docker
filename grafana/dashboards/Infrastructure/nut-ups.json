{
  "uid": "nut-ups",
  "title": "NAS UPS telemetry",
  "id": null,
  "version": 1,
  "schemaVersion": 39,
  "editable": false,
  "tags": [
    "ups",
    "nut",
    "monitoring"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Read-only NUT telemetry, separate from APC history. Pending real NAS USB handoff; no shutdown control.",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "UPS telemetry",
      "description": "Available means a fresh successful scrape with a recognized active status, not healthy power. Expected unavailable before the NAS USB handoff.",
      "datasource": {
        "type": "prometheus",
        "uid": "adw07verg2qrkd"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "orange"
                },
                "1": {
                  "text": "Available",
                  "color": "blue"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nut:telemetry_available",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Online flag",
      "description": "Independent UPS status flag. Unavailable is not zero; OL=0 does not imply OB=1.",
      "datasource": {
        "type": "prometheus",
        "uid": "adw07verg2qrkd"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not online"
                },
                "1": {
                  "text": "Online"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
