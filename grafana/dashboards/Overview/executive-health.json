        "x": 0,
        "y": 0,
        "w": 24,
        "h": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "adw07verg2qrkd"
      },
      "targets": [
        {
          "refId": "Kuma",
          "expr": "monitor_status{job=\"uptime-kuma\"} and on(job,instance) (up{job=\"uptime-kuma\"} == 1)",
          "instant": true,
          "range": false,
          "legendFormat": "kuma-{{monitor_id}}",
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          }
        },
        {
          "refId": "Containers",
          "expr": "max by (name) (container_last_seen{name=~\"ai-assistant-browser|ai-assistant-reviewer|bitwarden-db-1|cloudflare-duc|cloudflare-tunnel|cloudflared-pi|homelable-backend|lazywarden|recyclarr|socket-proxy|tracearr-db|tracearr-redis|unpackerr|uptime-kuma\"} and on(job,instance) (up == 1))",
          "instant": true,
          "range": false,
          "legendFormat": "container-{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          }
        },
        {
          "refId": "Collectors",
          "expr": "min by(job) (up)",
          "instant": true,
          "range": false,
          "legendFormat": "job-{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          }
        },
        {
          "refId": "Mount",
          "expr": "(max(node_filesystem_size_bytes{instance=\"ben-server\",mountpoint=\"/srv/Media\",fstype=~\"nfs.*|cifs\"} > bool 0) or (0 * max(node_filesystem_size_bytes{instance=\"ben-server\",mountpoint=\"/\"}))) and on() (max(up{job=\"node-exporter\",instance=\"ben-server\"}) == 1)",
          "instant": true,
          "range": false,
          "legendFormat": "mount",
          "datasource": {
            "type": "prometheus",
            "uid": "adw07verg2qrkd"
          }
        }
