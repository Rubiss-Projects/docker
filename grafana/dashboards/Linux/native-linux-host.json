  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU used",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "ddvyigh44dblsd"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "query": "SELECT 100 - mean(\"usage_idle\") FROM \"cpu\" WHERE $timeFilter AND \"host\" = 'ben-server' AND \"platform\" = 'native_linux' AND \"cpu\" = 'cpu-total' GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "policy": "default"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
