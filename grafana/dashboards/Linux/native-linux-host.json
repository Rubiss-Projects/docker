{
  "uid": "native-linux-host",
  "title": "Native Linux Host",
  "tags": [
    "linux",
    "native"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
