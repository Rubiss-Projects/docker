{
  "id": "tWmK9mxsrVcB6Nzb",
  "active": true,
  "name": "Restart Container on Down",
  "description": "Receives POST webhook notifications from Uptime Kuma when a monitored Docker container goes down (heartbeat status=0). It runs the repo-local self-heal script, which starts stopped containers and restarts unhealthy containers with bounded timeouts plus force-kill/start fallback when Docker restart gets stuck. Requires the monitor name in Uptime Kuma to match the Docker container name, which in this repo should also match the service folder name.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "restart-container",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "webhookId": "restart-container"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.heartbeat.status == 0 }}",
              "value2": true
            }
          ]
        }
      },
      "name": "If Down",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "command": "={{ 'node /mnt/e/Docker/n8n/scripts/self_heal_container.js --container ' + JSON.stringify(($json.body.monitor.docker_container || $json.body.monitor.name || '').toLowerCase()) }}"
      },
      "name": "Self-Heal Container",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "If Down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Down": {
      "main": [
        [
          {
            "node": "Self-Heal Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
