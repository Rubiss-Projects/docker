{
  "id": "tWmK9mxsrVcB6Nzb",
  "active": true,
  "name": "Restart Container on Down",
  "description": "Receives POST webhook notifications from Uptime Kuma when a monitored Docker container goes down (heartbeat status=0). Automatically restarts the matching container by calling the Docker Engine API through socket-proxy. Requires the monitor name in Uptime Kuma to match the Docker container name, which in this repo should also match the service folder name.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "restart-container",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "webhookId": "restart-container"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.body.heartbeat.status == 0 }}",
              "value2": true
            }
          ]
        }
      },
      "name": "If Down",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://socket-proxy:2375/containers/' + encodeURIComponent($json.body.monitor.name.toLowerCase()) + '/restart' }}",
        "options": {}
      },
      "name": "Restart Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "If Down",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Down": {
      "main": [
        [
          {
            "node": "Restart Container",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
