# Public, non-secret defaults for this service. Secrets live in the matching .env.secret file.
SERVER_NAME=ATE
WORLD_NAME=Dedicated
SERVER_PUBLIC=true
SERVER_ARGS="-modifier Resources most -modifier DeathPenalty casual -modifier Portals casual"

# Keep container-level world backups away from normal play and bound retention.
TZ=America/New_York
BACKUPS_CRON="5 4 * * *"
BACKUPS_MAX_AGE=30
BACKUPS_MAX_COUNT=7
